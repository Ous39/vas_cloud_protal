APP_ENV=development
APP_TIMEZONE=UTC
DEFAULT_SCHEMA=HeraTesting

DB_USER=vas_user
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Encrypts Integrations credentials (API keys/tokens/basic-auth) at rest. Optional — if unset, a
# random key is generated once and stored in vas_portal.app_secrets. Set this explicitly in
# production so encrypted credentials survive a database restore to a different environment.
# Generate one with: php -r "echo bin2hex(random_bytes(32));"
APP_ENCRYPTION_KEY=

# ============================================================================
# Real HeraProduction/HeraTesting database (fill these in yourself when ready — this file is
# never committed with real values, and this app never connects here on its own).
# Leaving these blank keeps HeraProduction/HeraTesting on the local Docker MySQL above, same as
# today. vas_portal (this app's own users/audit/API-keys/integrations data) is NOT affected by
# these — it always stays on DB_HOST/DB_USER/DB_PASSWORD above, never on this server.
# HERA_DB_HOST=192.168.164.138
# HERA_DB_PORT=31241
# HERA_DB_USER=
# HERA_DB_PASSWORD=
# ============================================================================

APP_PORT=8090
MYSQL_PORT=3307
PHPMYADMIN_PORT=8082
